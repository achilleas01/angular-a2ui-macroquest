# CopilotKit model provider: "local" (LM Studio / OpenAI-compatible server) or "openrouter"
# Both use the MacroQuest custom agent (A2UI catalog + sandbox UI).
COPILOT_MODEL_PROVIDER=openrouter

# OpenRouter (required when COPILOT_MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Deployment (docker compose) ---
# MODEL_BASE_URL=http://host.docker.internal:1234/v1   # LM Studio on the host
# MODEL_NAME=google/gemma-4-e4b
# CORS_ORIGINS=https://macroquest.example.com   # empty = same-origin only (default in compose)
# RATE_LIMIT_MAX=30                             # requests per window per client IP, 0 disables
# RATE_LIMIT_WINDOW_MS=60000
# RUNTIME_AUTH_TOKEN=                           # runtime requires "Authorization: Bearer <token>"
# RUNTIME_AUTH_HEADER=Bearer <token>            # nginx injects it, so it never reaches the browser
# WEB_PORT=80
